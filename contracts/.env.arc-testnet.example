# Arc Testnet network configuration.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Circle credentials. Keep real values server-side only and never expose them to
# frontend code.
CIRCLE_API_KEY=TEST_API_KEY_REPLACE_ME
CIRCLE_ENTITY_SECRET=ENTITY_SECRET_REPLACE_ME
# CIRCLE_API_URL=https://api.circle.com

# Circle developer-controlled wallet that deploys the contract and becomes the
# initial Ownable2Step owner.
VELOXPAY_ARC_TESTNET_DEPLOYER_WALLET_ID=00000000-0000-0000-0000-000000000000

# Arc Testnet token contracts to whitelist after deployment.
VELOXPAY_ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
VELOXPAY_ARC_TESTNET_EURC_ADDRESS=

# Use unique UUIDv4 values. Reuse the same values only when retrying the same
# deployment attempt after an uncertain network/API result.
VELOXPAY_ARC_TESTNET_DEPLOY_IDEMPOTENCY_KEY=00000000-0000-4000-8000-000000000001
VELOXPAY_ARC_TESTNET_USDC_APPROVAL_IDEMPOTENCY_KEY=00000000-0000-4000-8000-000000000002
VELOXPAY_ARC_TESTNET_EURC_APPROVAL_IDEMPOTENCY_KEY=00000000-0000-4000-8000-000000000003

# Optional tuning.
VELOXPAY_ARC_TESTNET_FEE_LEVEL=MEDIUM
VELOXPAY_ARC_TESTNET_POLL_INTERVAL_MS=5000
VELOXPAY_ARC_TESTNET_POLL_TIMEOUT_MS=600000
# VELOXPAY_ARC_TESTNET_DEPLOYMENT_OVERWRITE=false
# VELOXPAY_ARC_TESTNET_DEPLOYMENT_ARTIFACT=contracts/deployments/arc-testnet/VeloxPayRequests.deployment.json
