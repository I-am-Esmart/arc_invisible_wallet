CIRCLE_ENTITY_SECRET=your-rotated-entity-secret
CIRCLE_WALLET_SET_ID=
CIRCLE_WALLET_SET_NAME=VeloxPay Wallet Set
CIRCLE_BLOCKCHAIN=ARC-TESTNET
CIRCLE_GAS_STATION_ENABLED=true

